# =============================================================================
# 1. DADOS FINANCEIROS PESSOAIS & CONFIGURAÇÕES LOCAIS (NUNCA SUBIR PARA O GIT)
# =============================================================================
# Ignorar todos os extratos e faturas CSV em qualquer pasta
*.csv
*.CSV
*.ofx
*.OFX
*.qif
*.xlsx
*.xls

# Ignorar pastas de extratos e faturas (mantendo apenas .gitkeep da estrutura)
bankAccount/*
!bankAccount/.gitkeep
creditCard/*
!creditCard/.gitkeep

# Ignorar banco de configurações locais, regras aprendidas e overrides do usuário
data/
*.local.json
user-config.json

# =============================================================================
# 2. DEPENDÊNCIAS, BUILD & AMBIENTE TECH (Node.js / Vite / TypeScript)
# =============================================================================
node_modules/
dist/
dist-ssr/
build/
.vite/
coverage/
*.tsbuildinfo

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Logs de execução
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =============================================================================
# 3. SISTEMA OPERACIONAL & IDEs
# =============================================================================
.DS_Store
Thumbs.db
Desktop.ini
*.lnk
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
